fn sum(n: Int) -> Int {
    let s = 0;
    let i = 1;
    while (i <= n) {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn factorial(n: Int) -> Int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn main() -> Int {
    let s100 = sum(100);
    print(s100);
    let f6 = factorial(6);
    print(f6);
    return f6;
}
